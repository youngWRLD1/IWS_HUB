<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="IWSHubConnectionLocal"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=IWS Hub;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient"/>

		<add name="IWSHubConnectionRemote"
             connectionString="Server=192.168.110.91\SQLEXPRESS;Initial Catalog=IWS Hub;User Id=RemoteUser;Password=mcpassword!;TrustServerCertificate=True"
             providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<appSettings>
		<!-- Set to "Local" or "Remote" -->
		<add key="DatabaseMode" value="Local"/>
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
	</startup>
</configuration>